{
"$schema": "http://json-schema.org/draft-07/schema#",
"title": "EcoLifeFurnitureAndAppliancesSchema",
"description": "Cấu trúc chuẩn chung cho thư mục src/data/furniture/ (furniture_and_appliances.json), quy định tọa độ xếp lớp visual_slot, độ bền và danh sách thao tác tương tác.",
"version": "2.4.0",
"type": "object",
"properties": {
"$schema": { "type": "string" },
"title": { "type": "string" },
"description": { "type": "string" },
"version": { "type": "string" },
"furniture_items": {
"type": "array",
"minItems": 1,
"items": {
"type": "object",
"properties": {
"furniture_id": { "type": "string" },
"name_key": { "type": "string" },
"usage_type": {
"type": "string",
"enum": ["DURABLE_REUSABLE"]
},
"size_class": {
"type": "string",
"enum": ["BULKY_HOME_APPLIANCE", "MEDIUM_APPLIANCE", "SMALL_DECOR"]
},
"base_price_vnd": { "type": "integer", "minimum": 0 },
"sold_at_location_ids": {
"type": "array",
"items": { "type": "string" }
},
"placed_in_location_id": { "type": "string" },
"placed_in_sub_node_id": { "type": "string" },
"visual_slot": {
"type": "object",
"description": "Tọa độ neo % để Frontend vẽ xếp lớp ảnh ký họa lên bức tranh nền phòng trống",
"properties": {
"asset_id": { "type": "string" },
"anchor_x_pct": { "type": "number", "minimum": 0, "maximum": 100 },
"anchor_y_pct": { "type": "number", "minimum": 0, "maximum": 100 },
"width_pct": { "type": "number", "minimum": 1, "maximum": 100 },
"z_index": { "type": "integer", "minimum": 1 }
},
"required": ["asset_id", "anchor_x_pct", "anchor_y_pct", "width_pct", "z_index"]
},
"durability_rules": {
"type": "object",
"properties": {
"max_durability_pct": { "type": "number", "default": 100 },
"daily_wear_pct": { "type": "number" },
"wear_per_use_pct": { "type": "number" },
"malfunction_threshold_pct": { "type": "number", "default": 25.0 },
"broken_threshold_pct": { "type": "number", "default": 5.0 },
"repair_method": {
"type": "string",
"enum": ["HOME_TECHNICIAN_ONLY", "SHOP_OR_HOME_TECHNICIAN"]
}
},
"required": ["max_durability_pct", "broken_threshold_pct", "repair_method"]
},
"interactable_actions": {
"type": "array",
"items": {
"type": "object",
"properties": {
"action_id": { "type": "string" },
"label_key": { "type": "string" },
"duration_minutes": { "type": "integer", "minimum": 1 },
"requires_durability_min": { "type": "number", "default": 6.0 },
"consumes_item_id": { "type": "string" },
"produces_item_id": { "type": "string" },
"restores_durability_pct": { "type": "number" },
"happiness_delta": { "type": "number" },
"burnout_delta": { "type": "number" },
"effect": { "type": "string" }
},
"required": ["action_id", "label_key", "duration_minutes"]
}
}
},
"required": [
"furniture_id",
"name_key",
"usage_type",
"size_class",
"base_price_vnd",
"sold_at_location_ids",
"placed_in_location_id",
"placed_in_sub_node_id",
"visual_slot",
"durability_rules",
"interactable_actions"
]
}
}
},
"required": ["title", "version", "furniture_items"]
}